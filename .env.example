# Copy to .env (never commit .env). Every setting is optional.

# ---------- Backend (read at run time) ----------
# Port the server listens on. Most hosts set this for you.
PORT=8000
# Where downloaded SPHEREx cutouts are cached. Point at a persistent disk if
# the host has one, so restarts do not re-download from NASA.
SPHEREX_CACHE_DIR=/data/cache
# How long (seconds) an archive search is reused before asking IRSA again.
SPHEREX_SEARCH_TTL=3600
# Parallel downloads from IRSA. Above ~4 IRSA answers "server busy".
SPHEREX_MAX_PARALLEL=4
# Only needed when the website is hosted on a different domain than the API,
# e.g. https://spherex-blink.vercel.app (comma-separated list).
SPHEREX_CORS_ORIGINS=*
# Sentry error reporting for the API. Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
APP_VERSION=dev

# ---------- Frontend (baked in at build time) ----------
# Leave empty when one server hosts both site and API (the Docker image does).
# Set to the API's address when the site is hosted separately,
# e.g. https://spherex-blink-api.onrender.com
VITE_API_BASE=
# Sentry error reporting for the browser. Empty = off. Can be the same DSN.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0
